{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/prueba",
      "destination": "/index.html"
    },
    {
      "source": "/advertorial/berberina",
      "destination": "/advertorial-berberina.html"
    },
    {
      "source": "/advertorial/magnesio",
      "destination": "/advertorial-magnesio.html"
    },
    {
      "source": "/advertorial/berberina-ingredientes",
      "destination": "/advertorial-berberina-ingredientes.html"
    },
    {
      "source": "/advertorial/berberina-rutina",
      "destination": "/advertorial-berberina-rutina.html"
    },
    {
      "source": "/advertorial/magnesio-descanso",
      "destination": "/advertorial-magnesio-descanso.html"
    },
    {
      "source": "/advertorial/magnesio-cansancio",
      "destination": "/advertorial-magnesio-cansancio.html"
    }
  ]
}
