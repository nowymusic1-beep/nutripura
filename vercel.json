{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/prueba",
      "destination": "/index.html"
    },
    {
      "source": "/advertorial/berberina",
      "destination": "/advertorial-berberina.html"
    },
    {
      "source": "/advertorial/magnesio",
      "destination": "/advertorial-magnesio.html"
    },
    {
      "source": "/advertorial/berberina-ingredientes",
      "destination": "/advertorial-berberina-ingredientes.html"
    },
    {
      "source": "/advertorial/berberina-rutina",
      "destination": "/advertorial-berberina-rutina.html"
    },
    {
      "source": "/advertorial/magnesio-descanso",
      "destination": "/advertorial-magnesio-descanso.html"
    },
    {
      "source": "/advertorial/magnesio-cansancio",
      "destination": "/advertorial-magnesio-cansancio.html"
    },
    {
      "source": "/advertorial/magnesio-master",
      "destination": "/magnesio-master-web.html"
    },
    {
      "source": "/advertorial/magnesio-master-meli",
      "destination": "/magnesio-master-ml.html"
    },
    {
      "source": "/producto/berberina",
      "destination": "/producto-berberina.html"
    },
    {
      "source": "/producto/magnesio",
      "destination": "/producto-magnesio.html"
    }
  ],
  "redirects": [
    {
      "source": "/advertorial/berberina-video",
      "destination": "/berberina-video/web-1.html",
      "permanent": false
    },
    {
      "source": "/advertorial/berberina-video-meli",
      "destination": "/berberina-video/ml-1.html",
      "permanent": false
    }
  ]
}
